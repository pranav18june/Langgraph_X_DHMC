FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for psycopg2 and building packages
RUN apt-get update && apt-get install -y \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Poetry or pip requirements (using pip for simplicity since there is a Makefile but no requirements.txt yet)
# We will create a requirements.txt or install directly
COPY pyproject.toml .
# Assuming standard python setup, but let's install dependencies manually for now:
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    psycopg2-binary \
    redis \
    celery \
    python-dotenv \
    cryptography \
    pyjwt \
    blake3 \
    pydantic \
    langchain-core \
    langgraph \
    langgraph-checkpoint \
    cachetools \
    pytest

# Copy application
COPY . .

EXPOSE 8000

# Command to run FastAPI server
CMD ["uvicorn", "api:app", "--host", "0.0.0.0", "--port", "8000"]
