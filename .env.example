# Database configuration
POSTGRES_USER=dhmc_admin
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=dhmc_production

# Backend Service Connections
DATABASE_URL=postgresql://dhmc_admin:CHANGE_ME_postgres_password@postgres:5432/dhmc_production
REDIS_URL=redis://redis:6379/0

# Authentication
JWT_SECRET=CHANGE_ME_generate_a_random_64_char_hex_string
REQUIRE_AUTH=true

# Admin credentials (CHANGE THESE — defaults are insecure)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# DHMC Session Enclave
MASTER_ENCLAVE_KEY=CHANGE_ME_generate_a_random_64_char_hex_string

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:5001,http://localhost:3000
